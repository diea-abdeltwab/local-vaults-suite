{
  "name": "cinema-vault",
  "version": "1.0.0",
  "description": "Local Movies, Series & Anime Vault — Catppuccin Mocha",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux"
  },
  "build": {
    "appId": "com.catppuccin.cinema-vault",
    "productName": "Cinema Vault",
    "files": ["src/**/*", "assets/**/*"],
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo",
      "icon": "assets/icon.png"
    },
    "directories": { "output": "dist" }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
