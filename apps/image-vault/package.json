{
  "name": "image-vault",
  "version": "1.0.0",
  "description": "Local image vault — Catppuccin Mocha",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.local.image-vault",
    "productName": "Image Vault",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.0.0"
  }
}
