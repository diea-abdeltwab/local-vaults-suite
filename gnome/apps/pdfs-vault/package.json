{
  "name": "pdfs-vault",
  "version": "1.0.0",
  "description": "Local PDF Library Browser — Catppuccin Mocha theme",
  "license": "MIT",
  "author": "Diea Abdeltwab",
  "homepage": "https://github.com/diea-abdeltwab/local-vaults-suite/tree/main/gnome/apps/pdfs-vault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diea-abdeltwab/local-vaults-suite.git",
    "directory": "gnome/apps/pdfs-vault"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux"
  },
  "build": {
    "appId": "com.catppuccin.pdfs-vault",
    "productName": "PDFs Vault",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "assets/icon.png"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.0.0"
  }
}
